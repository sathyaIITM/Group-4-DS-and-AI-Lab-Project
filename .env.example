# Copy to .env and fill in. Never commit .env.

# Edge
SITE_ADDRESS=localhost

# Postgres (pgvector)
POSTGRES_USER=analyst
POSTGRES_PASSWORD=
POSTGRES_DB=analyst

# Decision models
# Kev served locally or on a GPU endpoint (see infra/README.md).
KEV_BASE_URL=http://host.docker.internal:8009
KEV_API_KEY=
KEV_TEMPERATURE=1.0
KEV_DTYPE=fp32
# Jev: TypeSafe AI directly, with OpenRouter as the second backend.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# Hosted LLM used for queries, plans, narration and clarifying questions
LLM_API_KEY=
LLM_MODEL=

# Tracing (Langfuse Cloud, free plan)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
