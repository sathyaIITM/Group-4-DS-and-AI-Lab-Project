# Edge proxy. SITE_ADDRESS=localhost serves plain HTTP for local work; a real
# host name makes Caddy obtain a certificate automatically.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Server-sent events: no buffering, no response timeout.
	@sse path /api/stream*
	reverse_proxy @sse api:8000 {
		flush_interval -1
	}

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle_path /admin/* {
		reverse_proxy admin:8001
	}

	handle {
		reverse_proxy ui:80
	}
}
